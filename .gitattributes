# Auto detect text files and normalize line endings to LF
* text=auto eol=lf

# Maven Wrapper
/mvnw text eol=lf
*.cmd text eol=crlf

# Gradle Wrapper
/gradlew text eol=lf
/gradlew.bat text eol=crlf

# Source and config files
*.java text eol=lf diff=java
*.xml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.properties text eol=lf
*.sql text eol=lf
*.md text eol=lf

# Binary files
*.jar binary
*.war binary
*.ear binary
*.class binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
